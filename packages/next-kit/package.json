{
  "name": "@qlover/next-kit",
  "description": "Shared Next.js app shell: isomorphic common layer, server runtime, and client runtime",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/common.js",
  "module": "./dist/common.js",
  "types": "./dist/common.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "require": "./dist/common.cjs"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "require": "./dist/common.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint src --fix",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:docs": "fe-code2md -p src -g docs --formatOutput prettier --removePrefix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlover/fe-base.git",
    "directory": "packages/next-kit"
  },
  "homepage": "https://github.com/qlover/fe-base/tree/master/packages/next-kit#readme",
  "keywords": [
    "next",
    "nextjs",
    "next-kit",
    "app-shell",
    "bootstrap"
  ],
  "author": "qlover",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@qlover/corekit-bridge": "workspace:*",
    "@qlover/fe-corekit": "workspace:*",
    "@qlover/logger": "workspace:*",
    "dayjs": "^1.11.18",
    "lodash-es": "^4.17.22",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "inversify": "^7.0.0",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "reflect-metadata": "^0.2.0",
    "sonner": "^1.0.0 || ^2.0.0",
    "zod": "^3.0.0 || ^4.0.0",
    "@qlover/oauth-wrapper": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "@qlover/oauth-wrapper": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qlover/oauth-wrapper": "workspace:*",
    "@supabase/supabase-js": "^2.57.2",
    "@types/lodash-es": "^4.17.12",
    "inversify": "^7.8.1",
    "next": "^16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.3",
    "zod": "^4.3.6"
  }
}
