{
  "name": "@qlover/next-kit",
  "description": "Shared Next.js app shell: isomorphic common layer, server runtime, and browser runtime",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/common.js",
  "module": "./dist/common.js",
  "types": "./dist/common.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "require": "./dist/common.cjs"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "require": "./dist/common.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint src --fix",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:docs": "fe-code2md -p src -g docs --formatOutput prettier --removePrefix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlover/fe-base.git",
    "directory": "packages/next-kit"
  },
  "homepage": "https://github.com/qlover/fe-base/tree/master/packages/next-kit#readme",
  "keywords": [
    "next",
    "nextjs",
    "next-kit",
    "app-shell",
    "bootstrap"
  ],
  "author": "qlover",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@qlover/corekit-bridge": "workspace:*",
    "@qlover/fe-corekit": "workspace:*",
    "@qlover/logger": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "^16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
