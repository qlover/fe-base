# Copy to `.env.localhost` / `.env.production` (or `.env`) as needed. Do not commit secrets.

# OAuth authorization server (PAM or next-oauth / any oauth-wrapper AS)
# Authorize URL becomes: {VITE_OAUTH_URL}/{locale}/oauth/authorize
# Register a public client redirect: {appOrigin}/{locale}/oauth/callback
VITE_OAUTH_URL=http://localhost:3200
VITE_OAUTH_CLIENT_ID=react-seed
VITE_OAUTH_SCOPE='openid profile email'
# Optional override (default: oauth/callback)
# VITE_OAUTH_REDIRECT_PATH=oauth/callback
# Set to 'true' to revoke the OAuth refresh token when logging out (default: false)
# VITE_OAUTH_REVOKE_ON_LOGOUT=false
